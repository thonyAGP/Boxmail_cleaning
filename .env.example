# =============================================================================
# Boxmail MCP — configuration d'exemple
# Copier vers .env et remplir. NE JAMAIS committer le .env réel.
# =============================================================================

# --- Serveur HTTP ---
# Port d'écoute local (le reverse proxy nginx/caddy fait le proxy_pass dessus)
PORT=8787
# Interface d'écoute. 127.0.0.1 = accessible uniquement depuis le reverse proxy
# local (recommandé). 0.0.0.0 = toutes interfaces (seulement si pas de proxy).
HOST=127.0.0.1

# --- Authentification de l'endpoint MCP ---
# Bearer token statique long/aléatoire exigé sur /mcp (header Authorization:
# Bearer <token>). Générer avec: npm run genkey
# 32+ octets aléatoires. C'est ce token qu'on colle dans Claude > Connectors.
MCP_BEARER_TOKEN=change-me-generate-with-npm-run-genkey

# --- Chiffrement des tokens au repos (AES-256-GCM) ---
# Clé de 32 octets encodée en base64. Générer avec: npm run genkey
# Si cette clé est perdue, accounts.json devient illisible → ré-enrôler les comptes.
TOKEN_ENCRYPTION_KEY=change-me-generate-with-npm-run-genkey

# --- OAuth Microsoft (app registration Entra) ---
# Client ID de l'app registration (audience: comptes Microsoft personnels).
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Authority. Pour comptes perso uniquement: .../consumers
# Pour multi-tenant + perso: .../common
MS_AUTHORITY=https://login.microsoftonline.com/consumers

# --- SMTP (envoi) — désactivé par défaut, HORS SCOPE v1 ---
ENABLE_SMTP_SEND=false

# --- Interface web d'administration ---
# Mot de passe de connexion à l'interface (http://<hote>:<port>/admin).
# Si absent, l'interface est désactivée (le serveur MCP fonctionne normalement).
# Générer par exemple avec : npm run genkey
ADMIN_PASSWORD=
# Durée de session (minutes) avant reconnexion. Défaut : 1440 (24 h).
ADMIN_SESSION_TTL_MINUTES=1440

# --- Rate limiting ---
# Nombre max de requêtes par fenêtre glissante (par IP) sur /mcp.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# --- Fichiers de données (chemins relatifs à la racine du projet) ---
ACCOUNTS_FILE=accounts.json
OPERATIONS_LOG=logs/operations.jsonl

# --- Serveurs Microsoft (valeurs par défaut, rarement à changer) ---
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587

# --- Base de données (index persistant des mails, Phase 3) ---
# SQLite : chemin relatif au dossier prisma/ ("file:../data/boxmail.db" =
# <racine>/data/boxmail.db). Aucun secret dedans (tokens dans accounts.json).
DATABASE_URL="file:../data/boxmail.db"
