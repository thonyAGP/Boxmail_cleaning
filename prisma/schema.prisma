// Boxmail MCP — index persistant des boîtes mail (Phase 3, SPEC V2 §7)
// SQLite via Prisma. Les chemins SQLite relatifs sont résolus par rapport à CE
// fichier : "file:../data/boxmail.db" = <racine du projet>/data/boxmail.db.
// Les tokens OAuth restent dans accounts.json (chiffrés AES-256-GCM) — la base
// ne contient AUCUN secret.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Miroir métier d'un compte enrôlé (les tokens restent dans accounts.json).
model Account {
  slug         String    @id
  emailAddress String
  displayName  String?
  // Couleur d'affichage choisie par l'utilisateur (hex #rrggbb — L5.8) ;
  // null = couleur automatique de la palette côté interface.
  color        String?
  // Quota IMAP de la boîte (RFC 2087, rafraîchi à chaque sync — L5.18) ;
  // null si le serveur ne l'expose pas.
  quotaUsedBytes  BigInt?
  quotaLimitBytes BigInt?
  // Diagnostic quota : date de la dernière tentative de lecture, et raison
  // en français quand la capacité reste inconnue (capacité QUOTA absente,
  // commande en échec…). Sans cela, « quota inconnu » était indiagnosticable
  // depuis l'interface (retour utilisateur 01/08).
  quotaCheckedAt DateTime?
  quotaNote      String?
  // Ordre d'affichage choisi par l'utilisateur (0 = premier). Les listes de
  // comptes (barre latérale, tableaux, sélecteurs) suivent cet ordre.
  sortOrder    Int       @default(0)
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  folders         Folder[]
  messages        Message[]
  threads         Thread[]
  senders         Sender[]
  attentionStates AttentionState[]
  deadlines       Deadline[]
  mailRules       MailRule[]
}

model Folder {
  id          Int       @id @default(autoincrement())
  accountSlug String
  path        String
  name        String
  delimiter   String?
  // inbox | sent | trash | archive | spam | drafts | custom
  role        String    @default("custom")
  uidValidity BigInt?
  lastUidSeen Int       @default(0)
  messageCount Int      @default(0)
  unseenCount  Int      @default(0)
  lastSyncedAt DateTime?

  account  Account   @relation(fields: [accountSlug], references: [slug], onDelete: Cascade)
  messages Message[]

  @@unique([accountSlug, path])
}

model Message {
  id                 Int       @id @default(autoincrement())
  accountSlug        String
  folderId           Int
  uid                Int
  internetMessageId  String?
  inReplyTo          String?
  threadId           Int?
  subject            String?
  normalizedSubject  String?
  fromName           String?
  fromEmail          String? // minuscules
  toEmails           String? // JSON string (SQLite n'a pas de type Json natif)
  date               DateTime?
  isSeen             Boolean   @default(false)
  isAnswered         Boolean   @default(false)
  isFlagged          Boolean   @default(false)
  // Réponse AUTOMATIQUE (répondeur, absence du bureau) — détectée sur le sujet.
  // Bug réel 02/08 : un répondeur arrivé 1 min après la réponse de l'utilisateur
  // remettait le fil dans « À répondre » ET le masquait dans « À relancer ».
  // Ces mails ne comptent ni comme « attend ta réponse » ni comme « réponse reçue ».
  isAutoReply        Boolean   @default(false)
  // Dépouillement (cycle « décision prise », indépendant de lu/non-lu) :
  // null = aucune décision ; sinon date + décision (range/keep/read/action/later…).
  reviewedAt         DateTime?
  reviewDecision     String?
  // true si envoyé par le compte lui-même (fromEmail == adresse du compte)
  isOutbound         Boolean   @default(false)
  sizeBytes          Int       @default(0)
  hasListUnsubscribe Boolean   @default(false)
  // Pièces jointes (L5.9) — rempli à la sync via bodyStructure. Les mails
  // indexés AVANT cette version restent à false tant qu'ils ne sont pas
  // resynchronisés à neuf (l'info n'est pas rejouée sur l'existant).
  hasAttachments     Boolean   @default(false)
  attachmentCount    Int       @default(0)
  // NOMS des pièces jointes, séparés par des retours à la ligne (11/08).
  // La sync lit déjà le bodyStructure pour compter les pièces : le nom était
  // là et on le jetait. C'est la clé de « retrouver sans classer » — on
  // cherche « bail », « quittance », « avis d'imposition » et on tombe sur le
  // fichier, même quand le sujet du mail ne dit rien.
  // null = jamais capturé (mails indexés avant cette version) ; le job
  // « noms des pièces » les rattrape sans télécharger aucune pièce.
  attachmentNames    String?
  // Fiche des pièces : JSON [{ n: nom, s: taille en octets }] (11/08).
  // La taille exacte vient de la même lecture de structure que les noms — elle
  // ne coûte rien de plus. Elle sert à repérer les DOUBLONS sans se tromper :
  // « photo.jpg » présent dans 7 mails, ce sont 7 photos différentes ; le même
  // nom AVEC la même taille au octet près, c'est le même fichier.
  // Séparée de `attachmentNames` pour que la recherche continue de porter sur
  // des noms propres, sans tomber sur des chiffres de taille.
  attachmentMeta     String?
  dossiers           DossierMessage[]
  // Extrait du texte du mail (C1) : ~500 caractères, texte cité retiré.
  // Rempli par le job « extraits » (services/snippets.ts) — une descente IMAP
  // qui ne télécharge QUE la partie texte, jamais les pièces jointes. C'est le
  // pré-requis de toute analyse de CONTENU : sans lui, ni les heuristiques ni
  // l'IA ne voient autre chose que le sujet.
  // null = jamais capturé (mails indexés avant cette version).
  snippet            String?
  snippetAt          DateTime?
  // Texte préparé POUR L'ANALYSE (11/08) : ~2 200 caractères SÉLECTIONNÉS,
  // structure en paragraphes conservée, passages sautés signalés par « […] ».
  //
  // Colonne DISTINCTE de `snippet`, et ce n'est pas un doublon. `snippet` sert
  // l'affichage et vaut 500 caractères aplatis ; surtout, `snippet IS NOT NULL`
  // est la définition même de « analysable » dans candidateWhere. Le remettre à
  // null pour le rallonger sortirait le mail du vivier d'analyse — les deux
  // critères se contredisent dès qu'on veut rallonger l'existant.
  //
  // POURQUOI 2 200 : la demande est très souvent en fin de message (« merci de
  // nous retourner le document signé avant le 30 »), et un mail d'agence
  // commence par trois paragraphes de politesse. À 500 caractères aplatis, on
  // gardait le préambule et on jetait la demande.
  analysisInput      String?
  // Version de ce qu'on a ENVOYÉ. Distincte du schéma du verdict et des
  // consignes : c'est ce triplet qui permet de choisir quoi relire.
  analysisInputVersion String?
  // Verdict de l'analyse IA (C2). CHOIX STRUCTURANT : l'IA n'écrit pas dans un
  // monde parallèle — elle renseigne AUSSI les champs existants (intent,
  // analysisConfidence, et la catégorie de l'expéditeur), pour que « Aujourd'hui »,
  // le nettoyage et l'importance en profitent SANS être modifiés.
  // `intentSource` porte la précédence : manual > ai > auto. Un recalcul
  // heuristique (backfill 🏷️) n'écrase jamais un intent posé par l'IA.
  // Contenu des PIÈCES JOINTES (10/08). Un mail « de maman » portant le scan
  // d'une facture Sosh était classé « payer maman » : sans lire la pièce,
  // l'analyse ne voit ni le vrai fournisseur, ni le montant. Rempli par le job
  // « pièces jointes » (services/attachments.ts) — extraction de texte locale,
  // aucun téléchargement conservé.
  // attachmentKind : text (lu) | scan (image/PDF scanné → à lire par l'IA) |
  // other (format non géré) ; null = jamais tenté.
  attachmentText     String?
  attachmentKind     String?
  attachmentTextAt   DateTime?
  aiSummary          String?
  aiAction           String?   // reply | pay | read | archive | none
  aiVerdictAt        DateTime?
  aiModel            String?
  // RÉSERVATION D'UN LOT D'ANALYSE (13/08). `next_analysis_batch` n'avait
  // aucun mécanisme de réservation : deux agents lancés sur la même boîte
  // recevaient les MÊMES mails (le tri est déterministe), d'où la règle « un
  // agent par boîte, scopes disjoints » qui empêchait de paralléliser.
  //
  // La réservation PÉRIME (30 min). C'est la propriété qui compte : une
  // session qui meurt en plein lot — ça vient d'arriver le 13/08 avec l'erreur
  // 400 du proxy — ne doit pas retirer ses mails du vivier pour toujours. Un
  // verrou sans expiration transformerait chaque plantage en perte sèche.
  claimedAt          DateTime?
  claimedBy          String?
  intentSource       String    @default("auto")
  // Intention détectée (A1 — pourquoi ce mail ? otp/invoice/shipping/…),
  // calculée à la sync sur les entrants, backfill via le job « categorize ».
  intent             String?
  intentReason       String?
  // Confiance de l'analyse (B4) : high | medium | low. Posée après chaque
  // sync (mails sans confiance) et par le backfill 🏷️. FAIBLE ⇒ le mail est
  // protégé de toute suppression automatique (PROTECTION_CLAUSES). Les
  // verdicts de l'écran « Vérifier l'analyse » (B2) priment sur le calcul.
  analysisConfidence       String?
  analysisConfidenceReason String?
  // true si le mail a disparu du serveur (supprimé/déplacé) depuis la sync
  isDeleted          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  account Account @relation(fields: [accountSlug], references: [slug], onDelete: Cascade)
  folder  Folder  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  thread  Thread? @relation(fields: [threadId], references: [id])
  verdict MailVerdict?

  @@unique([folderId, uid])
  @@index([accountSlug, fromEmail])
  @@index([accountSlug, internetMessageId])
  @@index([accountSlug, normalizedSubject])
  @@index([threadId])
  @@index([accountSlug, isDeleted, date])
  @@index([accountSlug, intent])
  @@index([aiAction])
  @@index([accountSlug, reviewedAt])
  @@index([claimedAt])
}

model Thread {
  id                Int       @id @default(autoincrement())
  accountSlug       String
  normalizedSubject String?
  firstMessageAt    DateTime?
  lastMessageAt     DateTime?
  // inbound | outbound — direction du dernier message du fil
  lastDirection     String?
  messageCount      Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  account  Account   @relation(fields: [accountSlug], references: [slug], onDelete: Cascade)
  messages Message[]

  @@index([accountSlug, normalizedSubject])
  @@index([accountSlug, lastMessageAt])
}

// État utilisateur d'un élément « à traiter » (Phase 4) : réponse en attente
// (kind=reply) ou relance (kind=followup). Permet de reporter (snooze) ou
// d'ignorer (dismiss) un fil. L'état est lié au DERNIER message entrant du fil
// au moment de l'action (messageId) : si un nouveau mail arrive ensuite dans le
// même fil, l'état devient caduc et l'élément réapparaît.
model AttentionState {
  id           Int       @id @default(autoincrement())
  accountSlug  String
  threadId     Int
  // id (colonne Message.id) du dernier message entrant au moment de l'action
  messageId    Int
  // reply | followup
  kind         String    @default("reply")
  // snoozed | dismissed
  state        String
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  account Account @relation(fields: [accountSlug], references: [slug], onDelete: Cascade)

  @@unique([accountSlug, threadId, kind])
  // Recherché par `messageId` seul quand un mail change de dossier
  // (`relinkMessageReferences`) : l'unique ci-dessus commence par `accountSlug`.
  @@index([messageId])
}

// Échéance détectée dans un mail (Phase 4, brique 4 — L2). Cycle de vie :
// proposed (détectée, à valider) → confirmed → done, ou dismissed.
// messageId/threadId sont des références souples (pas de FK vers Message :
// l'index des mails est un cache reconstructible, l'échéance doit survivre).
model Deadline {
  id          Int      @id @default(autoincrement())
  accountSlug String
  // id interne (colonne Message.id) du mail source
  messageId   Int
  threadId    Int?
  title       String
  date        DateTime
  // payment | document | appointment | renewal | other
  type        String   @default("other")
  // proposed | confirmed | dismissed | done | vetoed
  // « vetoed » (10/08) : une date A ÉTÉ trouvée, mais la proposition a été
  // ÉCARTÉE par l'arbitrage — typiquement parce que l'analyse du mail disait
  // « rien à faire ». On la garde au lieu de la faire disparaître, pour deux
  // raisons : pouvoir EXPLIQUER la décision à l'écran (« une proposition a
  // été écartée, voici pourquoi »), et pouvoir la RÉTABLIR si l'arbitrage
  // s'est trompé. Ces lignes ne comptent jamais comme des échéances.
  status      String   @default("proposed")
  /** Motif technique de l'écartement (ai_no_action…), null si non écartée. */
  vetoReason  String?
  confidence  Float    @default(0.6)
  // Justification en français (affichée telle quelle)
  reason      String
  // Extrait du texte où la date a été trouvée
  sourceText  String
  // Contexte d'affichage (dénormalisé pour survivre aux resync)
  fromEmail   String?
  fromName    String?
  subject     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountSlug], references: [slug], onDelete: Cascade)

  @@unique([accountSlug, messageId, date])
  @@index([accountSlug, status, date])
  // Créé par la migration manuscrite 20260730100000_audit_indexes — reporté ici
  // pour que Prisma ne le supprime pas à la prochaine migration (dérive constatée).
  @@index([messageId, status])
}

// Tâche (L5.5) : créée à la main, depuis un mail ou depuis une échéance.
// Références souples (pas de FK Message/Deadline : l'index est reconstructible,
// la tâche doit survivre) ; contexte dénormalisé pour l'affichage.
// Commandes Rentila (connecteur, phase 2 — 03/08). Boxmail PRÉPARE des ordres
// depuis les mails reçus, l'utilisateur les VALIDE dans l'interface (aperçu),
// et c'est Claude qui les EXÉCUTE via le connecteur MCP Rentila — aucun
// identifiant Rentila ne vit côté serveur (même décision que pour l'analyse
// IA : le pont passe par le forfait Claude de l'utilisateur). Le résultat est
// rapporté ici et journalisé.
model RentilaCommand {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // mark_rent_paid | create_task (extensible)
  kind        String
  // Paramètres structurés (JSON) interprétés par Claude côté Rentila
  params      String
  // Libellé humain montré dans l'interface et le journal
  label       String
  accountSlug String?
  // Mail d'origine (référence souple, comme Deadline)
  messageId   Int?
  // proposed | approved | done | failed | cancelled
  status      String    @default("proposed")
  result      String?
  executedAt  DateTime?

  @@index([status])
}

// Candidat « pièce comptable » (connecteur Fiscal-Manager V1 — 07/08, design
// docs/CONNECTEUR-FISCAL-MANAGER.md). Boxmail DÉTECTE (métadonnées seulement,
// jamais le PDF — l'IMAP reste le stockage durable) ; Fiscal-Manager tire la
// liste par curseur (seq) puis télécharge chaque pièce à la demande.
// candidateId = identité STABLE exposée à l'API ; le locator IMAP (dossier,
// uid) est lu au moment du téléchargement via la ligne Message, qui est
// relinkée quand un mail change de dossier (reconcileMoves). Un mail candidat
// est déjà protégé de toute suppression automatique par la protection
// centrale (hasAttachments + intent invoice/document) — voir retention.ts.
model AccountingCandidate {
  seq               Int      @id @default(autoincrement())
  candidateId       String   @unique
  accountSlug       String
  // Message.id — référence souple, relinkée par relinkMessageReferences.
  messageId         Int
  internetMessageId String?
  // Société proposée (jamais « certaine » — l'utilisateur corrige côté
  // Fiscal-Manager). companyBasis : MAILBOX_DEFAULT | NONE.
  companyCandidate  String?
  companyBasis      String   @default("NONE")
  // ACTIVE | SOURCE_MISSING (mail disparu du serveur avant l'import)
  status            String   @default("ACTIVE")
  detectedAt        DateTime @default(now())
  // Contexte dénormalisé (survit aux resync, sert la liste sans jointure)
  receivedAt        DateTime?
  fromName          String?
  fromEmail         String?
  subject           String?
  // JSON [{ attachmentId, index, filename, contentType, sizeBytes }] —
  // index = position dans listAttachmentParts (ordre downloadAttachment).
  attachmentsJson   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([accountSlug, messageId])
  // Recherché par messageId seul lors du relink des mails déplacés.
  @@index([messageId])
  @@index([status])
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  notes       String?
  dueDate     DateTime?
  // todo | done | dismissed
  status      String    @default("todo")
  // manual | mail | deadline
  source      String    @default("manual")
  accountSlug String?
  messageId   Int?
  deadlineId  Int?
  subject     String?
  fromEmail   String?
  fromName    String?
  folder      String?
  uid         Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  doneAt      DateTime?

  @@index([status, dueDate])
  // La protection centrale cherche « une tâche sur ce mail » à chaque ligne.
  @@index([messageId])
}

// Règle de classement (L7 — SPEC V2 Rule Engine). Cycle de vie :
// suggested (proposée, à valider) → active (applicable) → paused.
// GARDE-FOU : jamais appliquée sans validation — autoApply n'est possible
// que sur une règle activée explicitement par l'utilisateur.
model MailRule {
  id           Int       @id @default(autoincrement())
  accountSlug  String
  // sender (adresse exacte) | domain (…@domaine) | subject (le sujet contient)
  matchType    String
  matchValue   String
  // Chemin du dossier cible (créé au besoin à l'application)
  targetFolder String
  // suggested | active | paused
  status       String    @default("suggested")
  // true = appliquée automatiquement aux nouveaux mails à chaque sync
  autoApply    Boolean   @default(false)
  // Justification en français (affichée telle quelle)
  reason       String
  appliedCount  Int       @default(0)
  lastAppliedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  account Account @relation(fields: [accountSlug], references: [slug], onDelete: Cascade)

  @@unique([accountSlug, matchType, matchValue])
  @@index([accountSlug, status])
}

// Stratégie de rétention (A3 — Cap V3) : « les codes OTP de plus de 7 jours
// partent à la corbeille ». GLOBALE (toutes les boîtes), livrée en preset
// DÉSACTIVÉ — rien ne s'applique sans activation explicite, et autoApply
// exige enabled (même garde-fou que MailRule).
model RetentionPolicy {
  id            Int       @id @default(autoincrement())
  // Clé stable du preset (otp7, shipping30…) — unique, upsert idempotent.
  key           String    @unique
  label         String
  // Cible : intention du mail (Message.intent) et/ou catégorie de
  // l'expéditeur (Sender.category). Au moins l'un des deux.
  matchIntent   String?
  matchCategory String?
  // Cible fondée sur le VERDICT de l'analyse IA (C3c) : 'archive' vise les
  // mails que l'IA a lus un par un et jugés bons à archiver. Sans cela, ces
  // mails restaient hors d'atteinte : les stratégies « promo » et
  // « newsletter » exigent qu'un mail n'ait JAMAIS été ouvert, or 2 026 des
  // 3 263 mails jugés « à archiver » avaient été lus à l'époque.
  matchAiAction String?
  // true = ne vise que les mails JAMAIS lus (newsletters, promos).
  unseenOnly    Boolean   @default(false)
  ageDays       Int
  // trash (corbeille, récupérable ~30 j) — archive viendra plus tard.
  action        String    @default("trash")
  enabled       Boolean   @default(false)
  autoApply     Boolean   @default(false)
  appliedCount  Int       @default(0)
  lastAppliedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Suggestion d'apprentissage ignorée (A6) : « Ignorer » est définitif pour
// une suggestion donnée — elle ne sera jamais reproposée.
model SuggestionDismissal {
  id        Int      @id @default(autoincrement())
  // retention_auto | priority (les règles de classement ont leur propre cycle)
  kind      String
  // Référence stable : retention:<key> ou priority:<account>|<email>|<sens>
  refKey    String
  createdAt DateTime @default(now())

  @@unique([kind, refKey])
}

// Verdict de contrôle qualité (B2 — Série B) : l'utilisateur juge une analyse
// de l'assistant (réponse attendue, importance, newsletter, notification,
// candidat nettoyage). Une ligne par (moteur, mail) — revoter écrase l'avis
// précédent. Contexte dénormalisé pour survivre aux resync ; les CORRECTIONS
// passent par les mécanismes existants (catégorie manuelle, priorité,
// dismissals) — ici on ne stocke que le verdict et sa raison.
model AnalysisFeedback {
  id          Int      @id @default(autoincrement())
  // reply | important | newsletter | notification | cleanup
  engine      String
  accountSlug String
  // id interne (colonne Message.id) du mail jugé
  messageId   Int
  // correct | incorrect | unsure
  verdict     String
  // Raison choisie par l'utilisateur (facultative, en français)
  reason      String?
  subject     String?
  fromEmail   String?
  fromName    String?
  // Ce que le moteur affirmait au moment du verdict (justification affichée)
  claim       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([engine, messageId])
  // Recherché par `messageId` seul (échantillon de contrôle qualité,
  // réconciliation des mails déplacés) : l'unique ci-dessus commence par
  // `engine` et ne peut donc pas servir.
  @@index([messageId])
  @@index([engine, verdict])
}

// Exécution d'un brief (Phase 8 — L5). Le JSON complet du brief est stocké
// tel quel : il sert d'historique et de référence « nouveaux mails depuis le
// dernier brief ». Global (tous comptes), pas de relation Account.
model BriefRun {
  id          Int      @id @default(autoincrement())
  // daily | weekly
  type        String
  periodStart DateTime
  periodEnd   DateTime
  summaryJson String
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
}

// Agrégat par expéditeur, recalculé à chaque sync. kind/category/notes seront
// enrichis en Phase 4 (profils de correspondants).
model Sender {
  id               Int       @id @default(autoincrement())
  accountSlug      String
  email            String // minuscules
  displayName      String?
  domain           String?
  messageCount     Int       @default(0)
  unseenCount      Int       @default(0)
  unsubscribeCount Int       @default(0)
  totalSizeBytes   BigInt    @default(0)
  firstMessageAt   DateTime?
  lastMessageAt    DateTime?
  // person | company | newsletter | notification | platform | unknown (Phase 4)
  kind             String    @default("unknown")
  // Catégorie fine (A1 — qui écrit ? bank/admin/marketplace/…). null = jamais
  // calculée. categorySource=manual ⇒ la sync ne l'écrase JAMAIS.
  category         String?
  categorySource   String    @default("auto")
  categoryReason   String?
  // Date du dernier signe d'ENGAGEMENT avec cet expéditeur (P2.1) : un mail
  // sortant dans un de ses fils, un de ses mails étoilé ou répondu, une tâche.
  // Recalculé par rebuildSenders. PRÉ-CALCULÉ ICI POUR UNE RAISON DE PERF :
  // la même chose exprimée en sous-requête corrélée coûtait 40 s par
  // simulation (elle rejouait un auto-join de Message par LIGNE, soit 364²
  // opérations pour un expéditeur à 364 mails). Ici c'est une comparaison de
  // colonne. null = jamais d'engagement.
  engagedAt        DateTime?
  // Priorité par relation (A5) : normal | always_important | never_urgent.
  // Choix de l'utilisateur, jamais recalculée.
  priority         String    @default("normal")
  // Désinscription (P2.2) — extrait de l'en-tête List-Unsubscribe du dernier
  // mail de cet expéditeur. Stocké ici (et pas sur chaque mail) parce qu'on se
  // désinscrit d'un EXPÉDITEUR, pas d'un message.
  unsubscribeHttp    String?
  unsubscribeMailto  String?
  // RFC 8058 : l'expéditeur accepte une désinscription en un appel, sans
  // ouvrir de page ni confirmer — c'est la voie la plus sûre et la plus nette.
  unsubscribeOneClick Boolean  @default(false)
  // Trace de notre action : quand, et ce qui s'est passé.
  unsubscribedAt     DateTime?
  unsubscribeNote    String?
  notes            String?
  updatedAt        DateTime  @updatedAt

  account Account @relation(fields: [accountSlug], references: [slug], onDelete: Cascade)

  @@unique([accountSlug, email])
  @@index([accountSlug, messageCount])
  // Les stratégies de rétention filtrent sur la catégorie : sans cet index,
  // l'aperçu « newsletters » prenait 7,5 s sur 35 000 mails, 65 ms avec.
  @@index([accountSlug, category])
}

/// Dossier (11/08) — un SUJET DE VIE qui traverse les interlocuteurs.
///
/// Demande : « va jusqu'au dossier ». Un bien immobilier passe par l'agence,
/// le notaire, la banque, le syndic, l'assureur, l'architecte, le fournisseur
/// d'énergie… Regrouper par expéditeur éclate le dossier ; le regrouper par
/// ADRESSE ou par NUMÉRO DE RÉFÉRENCE le reconstitue. Mesuré sur ses vraies
/// boîtes : « 46 rue de la République » apparaît chez 45 correspondants
/// différents et dans 4 de ses boîtes.
///
/// DURABLE, et c'est tout l'enjeu : ce qui est stocké, c'est la CLÉ. Un mail
/// qui arrive demain et qui cite l'adresse rejoint le dossier tout seul, à la
/// synchronisation — sans qu'on ait à rejouer une recherche.
model Dossier {
  id          Int      @id @default(autoincrement())
  /// Clé normalisée (accents retirés, liaisons supprimées) — l'identité stable.
  key         String   @unique
  /// bien | societe | vehicule | personne | affaire | reference | autre
  kind        String   @default("bien")
  /// Nom affiché, renommable par l'utilisateur sans casser la clé.
  label       String
  /// Variantes d'écriture rencontrées, en JSON — HISTORIQUE. Remplacé par la
  /// table DossierAlias (indexée, et repointable lors d'une fusion) ; conservé
  /// le temps que la reprise des données soit passée partout.
  aliases     String?
  /// auto = libellé posé par l'analyse ; manual = renommé par l'utilisateur.
  /// Une réanalyse ne réécrit JAMAIS un libellé manuel — sinon sa correction
  /// serait effacée au tour suivant et il ne recommencerait pas deux fois.
  labelSource String   @default("auto")
  /// auto = proposé ; confirmed = validé ; hidden = écarté ; merged = absorbé.
  status      String   @default("auto")
  /// Dossier absorbant, quand celui-ci a été fusionné. La résolution suit ce
  /// renvoi : un mail qui arrive demain avec l'ANCIENNE orthographe atterrit
  /// dans le dossier cible. C'est ce qui fait qu'une fusion manuelle survit à
  /// une réanalyse au lieu d'être défaite à chaque nouveau mail.
  mergedIntoId Int?
  messageCount Int     @default(0)
  firstAt     DateTime?
  lastAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    DossierMessage[]
  aliasRows   DossierAlias[]
  identifiers DossierIdentifier[]
  mergedInto  Dossier?  @relation("Fusion", fields: [mergedIntoId], references: [id])
  absorbes    Dossier[] @relation("Fusion")

  @@index([status])
  @@index([mergedIntoId])
}

/// Orthographe rencontrée pour un dossier. L'IA écrira « 46 rue de la
/// République », puis « Immeuble République », puis « 46 Rue République
/// Brest » : ce n'est pas un défaut du modèle, c'est le mauvais outil pour
/// assurer l'identité. Le SERVEUR tient l'identité, à partir de ces alias.
///
/// Table plutôt que JSON : la recherche devient indexée, et une fusion se
/// résume à repointer les lignes au lieu de fusionner deux blobs.
model DossierAlias {
  id        Int      @id @default(autoincrement())
  dossierId Int
  /// Clé normalisée de l'alias — c'est elle qu'on interroge.
  key       String   @unique
  /// Orthographe telle que rencontrée, pour l'afficher à l'utilisateur.
  label     String
  /// ia | manuel | fusion
  source    String   @default("ia")
  createdAt DateTime @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
}

/// Identifiant DUR d'un dossier : numéro de contrat, de sinistre, de dossier
/// judiciaire, SIRET, plaque. Quand il est présent, il PRIME sur l'orthographe
/// — deux mails qui citent le même numéro de sinistre parlent du même dossier,
/// quel que soit le nom que chaque correspondant lui donne.
model DossierIdentifier {
  id        Int      @id @default(autoincrement())
  dossierId Int
  /// contract | claim | case | siret | plate | invoice | other
  kind      String   @default("other")
  /// Valeur normalisée (majuscules, séparateurs retirés).
  value     String
  source    String   @default("ia")
  createdAt DateTime @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@unique([kind, value])
  @@index([dossierId])
}

/// Verdict sémantique d'un mail (11/08) — le socle de la refonte de l'analyse.
///
/// POURQUOI. Jusqu'ici le verdict de l'IA s'écrasait dans quatre colonnes
/// plates de Message (intent, aiAction, analysisConfidence, aiSummary), et 21
/// services appliquaient par-dessus leurs propres règles écrites à la main.
/// D'où le reproche d'Anthony : « ta conception est à corriger à chaque
/// nouveau cas et en oublie systématiquement ».
///
/// LE POINT NON NÉGOCIABLE : `raw` est le verdict d'origine, IMMUABLE. Tout le
/// reste — les colonnes ci-dessous et les tables Verdict* — n'en est qu'une
/// PROJECTION, recalculable. Parce que dans six mois on voudra changer le
/// briefing sans changer ce que l'IA avait compris du mail.
///
/// Les colonnes dépliées ici obéissent à une règle : elles n'existent que si
/// un moteur filtre ou trie dessus. Le reste vit dans `raw`.
model MailVerdict {
  id             Int      @id @default(autoincrement())
  messageId      Int      @unique
  /// Le JSON rendu par l'IA, tel quel. Ne se réécrit jamais.
  raw            String
  /// Forme du verdict. Sert à sélectionner quoi relire, sans tout relire.
  schemaVersion  Int      @default(1)
  /// Version des consignes données à l'IA.
  promptVersion  String   @default("1")
  /// Version de ce qu'on lui a ENVOYÉ (500 car. ? 2 500 ? pièces ? fil ?).
  inputVersion   String   @default("1")
  model          String?
  /// complete | partial | failed
  analysisStatus String   @default("complete")
  /// Ce que l'IA a réellement pu voir — l'aveu de ce qui lui manquait.
  inputCoverage  String?
  /// Fonction du message (liste fermée courte et stable).
  purpose        String?
  /// Sous-type LIBRE : flight_check_in_reminder, temporary_service_outage…
  /// C'est lui qui absorbe les cas nouveaux sans migration ni réanalyse.
  subtype        String?
  summary        String?
  /// Fenêtre d'attention — c'est ici que se règle la péremption, sans veto.
  /// persistent | until_time | while_action_open | while_event_future |
  /// until_superseded | none | unknown
  attentionMode  String?
  attentionUntil DateTime?
  /// Précision de la date ci-dessus : « mai » n'est pas « le 12 mai à 14 h ».
  attentionPrecision String?
  attentionBasis String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  message       Message              @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actions       VerdictAction[]
  events        VerdictEvent[]
  documents     VerdictDocument[]
  mentions      EntityMention[]
  contexts      VerdictContext[]
  uncertainties VerdictUncertainty[]

  /// Le briefing cherche « ce qui n'est pas encore périmé ».
  @@index([attentionMode, attentionUntil])
  /// La réanalyse par vagues sélectionne sur les versions.
  @@index([schemaVersion, promptVersion])
  @@index([purpose])
}

/// Ce qui est attendu, DE QUI, pour quand, et jusqu'à quand ça a du sens.
///
/// `dueAt` ≠ `expiresAt`, et c'est toute la correction du cas Air France :
/// un paiement dû le 15 juin reste à faire le 16 ; un enregistrement pour un
/// vol du 16 juin n'a plus aucun sens le 17.
model VerdictAction {
  id        Int      @id @default(autoincrement())
  verdictId Int
  /// Dénormalisé : tous les moteurs partent du mail, pas du verdict.
  messageId Int
  /// pay | reply | sign | provide_document | book | call | attend | renew |
  /// declare | confirm | review | other
  kind      String
  label     String?
  /// user | sender | third_party | unknown — QUI doit agir. Sans ce champ,
  /// « maman transmet une facture Sosh » devenait « payer maman ».
  actor     String   @default("unknown")
  /// required | requested | optional | informational
  strength  String   @default("requested")
  dueAt          DateTime?
  duePrecision   String?
  expiresAt      DateTime?
  expiresPrecision String?
  amount    Float?
  currency  String?
  reference String?
  /// explicit | strong_inference | weak_inference | unknown
  certainty String   @default("unknown")
  /// Citation du texte : la règle anti-invention.
  evidence       String?
  evidenceSource String?

  verdict MailVerdict @relation(fields: [verdictId], references: [id], onDelete: Cascade)

  @@index([messageId])
  /// « qu'est-ce qui est dû, et bientôt ? » — la requête du briefing.
  @@index([kind, actor, dueAt])
  @@index([expiresAt])
}

/// Rendez-vous, voyage, fenêtre de service. `participation` distingue « il y
/// est » de « on l'informe que ça a lieu » — c'est ce qui évitait de
/// transformer « paiements indisponibles le 12 mai » en échéance.
model VerdictEvent {
  id        Int      @id @default(autoincrement())
  verdictId Int
  messageId Int
  /// appointment | travel | service_window | delivery | meeting | other
  kind      String
  label     String?
  startsAt  DateTime?
  startsPrecision String?
  endsAt    DateTime?
  /// participant | informational | unknown
  participation String @default("unknown")
  certainty String   @default("unknown")
  evidence  String?

  verdict MailVerdict @relation(fields: [verdictId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([kind, startsAt])
}

/// Facture, devis, contrat, avis d'imposition… `issuer` est QUI ÉMET, jamais
/// qui envoie le mail.
model VerdictDocument {
  id        Int      @id @default(autoincrement())
  verdictId Int
  messageId Int
  /// invoice | quote | contract | receipt | tax_notice | statement |
  /// certificate | report | id_document | legal_notice | other
  kind      String
  label     String?
  issuer    String?
  issueDate DateTime?
  dueDate   DateTime?
  amount    Float?
  currency  String?
  reference String?
  certainty String   @default("unknown")
  evidence  String?

  verdict MailVerdict @relation(fields: [verdictId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([kind, issueDate])
  /// Le connecteur comptable cherche les factures d'un émetteur donné.
  @@index([issuer])
}

/// MENTION d'entité, jamais identité. L'IA propose « 46 rue de la
/// République », puis « Immeuble République » : le serveur tiendra l'identité
/// (lot 3), à partir de ces mentions et des identifiants.
model EntityMention {
  id        Int    @id @default(autoincrement())
  verdictId Int
  messageId Int
  /// person | company | property | vehicle | contract | service | account | other
  kind      String
  nameRaw   String
  /// sent_by | issued_by | concerns | billed_to | pays | represents |
  /// mentioned | other
  role      String @default("mentioned")
  /// SIRET, n° de contrat, plaque… ce qui permet de recoller sans orthographe.
  identifier String?
  certainty String @default("unknown")
  evidence  String?

  verdict MailVerdict @relation(fields: [verdictId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([kind, nameRaw])
  @@index([identifier])
}

/// Le dossier, en MENTION. Résolu localement vers un identifiant stable au
/// lot 3 — le regroupement se fera sur l'identifiant, jamais sur la chaîne.
model VerdictContext {
  id        Int    @id @default(autoincrement())
  verdictId Int
  messageId Int
  /// property | company | affair | vehicle | reference | other
  kind      String
  label     String
  certainty String @default("unknown")
  evidence  String?

  verdict MailVerdict @relation(fields: [verdictId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([kind, label])
}

/// Le doute, exploitable : il dit COMMENT le lever. C'est ce qui permet la
/// seconde passe ciblée (2 à 5 % des mails) au lieu de tout relire.
model VerdictUncertainty {
  id        Int     @id @default(autoincrement())
  verdictId Int
  messageId Int
  fieldPath String?
  /// not_present | ambiguous | truncated_input | missing_attachment |
  /// missing_thread_context | conflicting_evidence
  reason    String
  description String?
  /// full_body | attachment_text | thread_context | manual_review | none
  resolvableWith String?

  verdict MailVerdict @relation(fields: [verdictId], references: [id], onDelete: Cascade)

  @@index([messageId])
  /// La sélection de la passe B part d'ici.
  @@index([reason, resolvableWith])
}

/// Rattachement d'un mail à un dossier (un mail peut en citer plusieurs).
model DossierMessage {
  dossierId Int
  messageId Int
  /// Où la clé a été vue : subject | summary | snippet | attachment
  source    String   @default("subject")
  createdAt DateTime @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([dossierId, messageId])
  @@index([messageId])
}
