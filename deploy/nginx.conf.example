# =============================================================================
# nginx — reverse proxy TLS pour boxmail-mcp (mcp.lb2i.fr)
# =============================================================================
# À adapter puis inclure dans la conf nginx de l'instance (sites-available).
# TLS via le mécanisme existant (certbot/Let's Encrypt). HSTS activé ici.
#
# Le firewall OCI restreint déjà 443 aux IP Anthropic (voir oci-firewall.md) ;
# ce bloc ajoute la défense applicative (bearer token géré par l'app Node).
# =============================================================================

# Redirection HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name mcp.lb2i.fr;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mcp.lb2i.fr;

    # Envois avec pièces jointes : nginx limite les corps à 1 Mo par défaut
    # (erreur 413 avant même d'atteindre l'app). Express garde ses propres
    # limites par route (30 Mo sur /send, 4 Mo ailleurs).
    client_max_body_size 32m;

    # --- TLS (chemins gérés par certbot) ---
    ssl_certificate     /etc/letsencrypt/live/mcp.lb2i.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp.lb2i.fr/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # --- HSTS (HTTPS uniquement) ---
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Le SDK MCP Streamable HTTP utilise du SSE : pas de buffering, timeouts longs.
    location /mcp {
        proxy_pass http://127.0.0.1:8787/mcp;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streaming SSE : ne pas bufferiser, garder la connexion ouverte.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        chunked_transfer_encoding on;
    }

    # Health check (facultatif d'exposer publiquement — sinon restreindre).
    location = /health {
        proxy_pass http://127.0.0.1:8787/health;
        proxy_set_header Host $host;
        access_log off;
    }
}
