# =============================================================================
# .env de PRODUCTION (serveur Oracle Cloud) — modèle L6
# =============================================================================
# À copier en `.env` à la racine du projet SUR LE SERVEUR, puis remplacer
# chaque <...>. Le script deploy/setup-oracle.sh le fait automatiquement.
# JAMAIS commité — contient les secrets du serveur.
#
# Générer les secrets :
#   TOKEN_ENCRYPTION_KEY : npm run genkey
#   MCP_BEARER_TOKEN     : openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
#   ADMIN_PASSWORD       : une phrase de passe FORTE (gestionnaire de mots de passe)

# --- HTTP ---
# L'app écoute en local uniquement : c'est nginx (443, TLS) qui est exposé.
PORT=8787
HOST=127.0.0.1
# Derrière nginx : lit l'IP réelle du client dans X-Forwarded-For
# (rate limits par visiteur, pas globaux). Toujours 1 en prod.
TRUST_PROXY=1

# --- URL publique (interface + retour OAuth d'enrôlement) ---
# Active aussi le flag Secure sur le cookie de session (https).
PUBLIC_BASE_URL=https://mcp.lb2i.fr

# --- Secrets (OBLIGATOIRES, tous différents de ceux du PC local) ---
# Token exigé par Claude pour parler à /mcp (connecteur Cowork).
MCP_BEARER_TOKEN=<openssl rand -base64 48>
# Clé AES-256-GCM de chiffrement des tokens OAuth (32 octets base64).
# NOUVELLE clé pour le serveur — ne pas réutiliser celle du PC (sauf si tu
# copies accounts.json depuis le PC : dans ce cas il faut la MÊME clé).
TOKEN_ENCRYPTION_KEY=<npm run genkey>
# Mot de passe de l'interface web /admin (exposée sur Internet : FORT).
ADMIN_PASSWORD=<phrase de passe forte>

# --- Microsoft Entra (identique au PC : même app « boxmail-mcp ») ---
MS_CLIENT_ID=00449d9d-90ad-4891-939b-7e55f4d4d816
# Ne pas oublier d'ajouter la redirect URI côté Entra :
#   https://mcp.lb2i.fr/api/enroll/callback   (plateforme Mobile & desktop)

# --- Synchronisation automatique (serveur 24/7) ---
SYNC_INTERVAL_MINUTES=30

# --- Divers ---
LOG_LEVEL=info
# Rate limit /mcp et /api (par IP réelle grâce à TRUST_PROXY).
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
